# Web / iOS simulator. Android emulator: http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional overrides; app.json already links the team's existing EAS project.
# Leave empty to retain it. Do not create a second project.
EAS_PROJECT_ID=
EAS_PROJECT_OWNER=
# Optional config file paths (EAS file environment variables are supported).
GOOGLE_SERVICES_ANDROID=./google-services.json
GOOGLE_SERVICES_IOS=./GoogleService-Info.plist

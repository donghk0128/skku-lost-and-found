# Copy to .env and keep the real values out of Git.
# Use a PostgreSQL role with SELECT only on the five exported tables.
SOURCE_DATABASE_URL=postgresql://readonly:change-me@host:5432/postgres?sslmode=require
GCP_PROJECT_ID=project-2d59f32a-6674-4fa9-9a4
BIGQUERY_DATASET=skku_finder_raw
BIGQUERY_LOCATION=asia-northeast3
# Generate once with `openssl rand -hex 32`; all Airflow services must share it.
AIRFLOW_JWT_SECRET=replace-with-a-random-hex-value
# Local: host path created by gcloud ADC impersonation; it contains a refresh
# credential and must stay outside Git. EC2: ./secrets/gcp-adc.json generated
# with AWS Workload Identity Federation and --enable-imdsv2 (no private key).
GCP_ADC_FILE=C:/Users/your-user/AppData/Roaming/gcloud/application_default_credentials.json
# For a first run, trigger the DAG with {"full_refresh": true}.

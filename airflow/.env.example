# Copy to .env and keep the real values out of Git.
# Use a PostgreSQL role with SELECT only on the six exported tables.
SOURCE_DATABASE_URL=postgresql://readonly:change-me@host:5432/postgres?sslmode=require
GCP_PROJECT_ID=your-project-id
BIGQUERY_DATASET=skku_raw
BIGQUERY_LOCATION=asia-northeast3
# Mount a service-account JSON file at this path, or use ADC locally.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json
# For a first run, trigger the DAG with {"full_refresh": true}.

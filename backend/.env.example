# PostgreSQL (Supabase direct connection string, adapted for SQLAlchemy)
DATABASE_URL=

# Generate a unique, long random value. Never commit your actual .env file.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ALLOWED_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]

# Docker Compose defaults to console for tests without real delivery.
# Compose EMAIL_DELIVERY_MODE can be overridden from the root .env or shell.
EMAIL_DELIVERY_MODE=console

# Required only when EMAIL_DELIVERY_MODE=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SKKU 찾자
SMTP_USE_TLS=true

EMAIL_VERIFICATION_EXPIRE_MINUTES=5
EMAIL_VERIFICATION_RESEND_SECONDS=60
ALLOWED_EMAIL_DOMAIN=skku.edu

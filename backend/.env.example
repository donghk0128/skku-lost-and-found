# PostgreSQL (Supabase direct connection string, adapted for SQLAlchemy)
DATABASE_URL=

# Generate a unique, long random value. Never commit your actual .env file.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ALLOWED_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]

# Docker Compose reads these values from backend/.env.
# Use console explicitly only for development without real email delivery.
EMAIL_DELIVERY_MODE=smtp

# Required only when EMAIL_DELIVERY_MODE=smtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail: use an app password issued after enabling 2-Step Verification.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SKKU FINDER
# STARTTLS on port 587 (not implicit SSL on port 465).
SMTP_USE_TLS=true

EMAIL_VERIFICATION_EXPIRE_MINUTES=5
EMAIL_VERIFICATION_RESEND_SECONDS=60
ALLOWED_EMAIL_DOMAIN=skku.edu

# AI-assisted post drafts. The provider and model are selected server-side.
AI_PROVIDER=openai
AI_MODEL=replace-with-your-ai-model-name
AI_TIMEOUT_SECONDS=120
AI_REASONING_EFFORT=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=replace-with-your-jopen-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: create 768-dimensional post embeddings for recommendations.
# Keep this key on the backend only. Without it, rule-based matching still works.
GEMINI_API_KEY=
GEMINI_EMBEDDING_TIMEOUT_SECONDS=10

# Optional LangSmith tracing for LangGraph. Trace inputs and outputs are visible.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=skku-lost-and-found-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
